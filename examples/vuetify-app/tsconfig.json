{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "jsx": "preserve", "skipLibCheck": true, "noEmit": true,
    "types": ["vite/client"],
    "paths": { "~/*": ["./src/*"] }, "baseUrl": "."
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
